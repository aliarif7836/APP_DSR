# Base URL of the HR dashboard. Change to point at any environment.
BASE_URL=https://dashboard.appinventiv.com

# Login credentials (official email + password). NEVER commit the real .env.
ADMIN_EMAIL=your.name@appinventiv.com
ADMIN_PASSWORD=your-password-here

# ---------- DSR form defaults ----------
DSR_PROJECT=Whataburger
DSR_ESTIMATED_HOURS=8:30
DSR_USED_AI_TOOLS=yes
DSR_DESCRIPTION_FILE=dsr-description.txt

# chromium | firefox | webkit   (webkit = Safari engine)
BROWSER=chromium

# true = no visible browser window; false = watch it run
HEADLESS=false

# Default viewport
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
